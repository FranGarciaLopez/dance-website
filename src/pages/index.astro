---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/HeroSection.astro";
import Knowledge from "@/components/Knowledge.astro";
import Benefits from "@/components/Benefits.astro";
import Schedule from "@/components/Schedule.astro";
import Partners from "@/components/Partners.astro";
import ImageMasonry from "@/components/ImageMasonry.astro";
import HistoryLocation from "@/components/HistoryLocation.astro";
import Logros from "@/components/Logros.astro";
import { galleryImages } from "@/data/galleryImages";

/*const KnowledgeData = [
  {
    title: "Conexión en Pareja",
    image: "https://res.cloudinary.com/dgvvnopu7/image/upload/v1757001636/DSC01238_iotxnv.webp",
    shortDesc:
      "Aprende a guiar y dejarte guiar, creando una conexión auténtica con tu pareja de baile.",
  },
  {
    title: "Estilo y Expresión",
    image: "https://res.cloudinary.com/dgvvnopu7/image/upload/v1757001636/DSC01238_iotxnv.webp",
    shortDesc:
      "Añade tu toque personal a cada paso y disfruta expresando emociones en la pista.",
  },
  {
    title: "Musicalidad",
    image: "https://res.cloudinary.com/dgvvnopu7/image/upload/v1757001636/DSC01238_iotxnv.webp",
    shortDesc:
      "Aprende a interpretar la música, marcando pausas, acentos y jugando con los tiempos.",
  },
];*/
---

<Layout
  title="🕺 The Latin Action - Clases de Salsa y Bachata en Elche con Juan Carlos"
  description="🥇 Academia de baile latino #1 en Elche ⭐ Clases de Salsa y Bachata para todos los niveles 📍 Elche, Novelda, Elda 📞 645 08 91 22 ✅ Profesores certificados con +20 años de experiencia"
  keywords="clases salsa Elche, clases bachata Elche, academia baile Elche, bachata sensual Elche, salsa cubana Elche, baile latino Alicante, Juan Carlos baile, The Latin Action, profesor salsa Novelda, clases baile Elda, academia danza latina Elche, escuela baile latino"
  canonical="https://thelatinaction.com/"
  ogImage="https://res.cloudinary.com/dgvvnopu7/image/upload/v1778925128/Juan_Carlos_-_The_latin_Action_Salsa_y_Bachata_Company_umvorm.jpg"
  ogType="website"
>
  <!-- Enhanced FAQ Schema for better SEO -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Dónde están las clases de salsa y bachata en Elche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Latin Action imparte clases en varios centros de Elche: Academia Dairen, Bubaloo Academia, y también en Novelda (NVFit) y Elda (Estudio42). Consulta nuestros horarios para más detalles."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuestan las clases de bachata en Elche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los precios varían según la modalidad y centro. Contacta con nosotros al 645 08 91 22 para información detallada sobre tarifas y packs de clases."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito pareja para las clases de salsa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, no necesitas venir con pareja. En nuestras clases rotamos durante la práctica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué nivel necesito para empezar a bailar salsa o bachata?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ningún nivel previo es necesario. Tenemos clases para principiantes absolutos y todos los niveles. Juan Carlos adapta las clases a cada alumno."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo son las clases de bachata y salsa en Elche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tenemos clases de lunes a viernes en diferentes horarios y ubicaciones. Consulta nuestro horario actualizado en la web o llama al 645 08 91 22."
          }
        }
      ]
    }
  </script>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://thelatinaction.com/"
        }
      ]
    }
  </script>

  <!-- WebSite Schema with SearchAction -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://thelatinaction.com/",
      "name": "The Latin Action",
      "description": "Academia líder de salsa y bachata en Elche",
      "publisher": {
        "@type": "Organization",
        "name": "The Latin Action"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://thelatinaction.com/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- Course Aggregation Schema -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Clases de Baile Latino en Elche",
      "description": "Modalidades de baile disponibles en The Latin Action",
      "itemListElement": [
        {
          "@type": "Course",
          "position": 1,
          "name": "Bachata y Salsa en Pareja",
          "description": "Clases de Bachata y Salsa en Pareja en Elche, Novelda y Elda con Juan Carlos",
          "provider": {
            "@type": "Organization",
            "name": "The Latin Action",
            "sameAs": "https://thelatinaction.com/"
          },
          "courseCode": "BACHATA-SALSA-PAREJA",
          "url": "https://thelatinaction.com/",
          "hasCourseInstance": {
            "@type": "CourseInstance",
            "courseMode": "onsite",
            "location": {
              "@type": "Place",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Elche",
                "addressRegion": "Alicante",
                "addressCountry": "ES"
              }
            }
          }
        }
      ]
    }
  </script>

  <main class="text-white">
    <HeroSection
      mobileImage="https://res.cloudinary.com/dgvvnopu7/image/upload/v1778925128/Juan_Carlos_-_The_latin_Action_Salsa_y_Bachata_Company_umvorm.jpg"
      tabletImage="https://res.cloudinary.com/dgvvnopu7/image/upload/v1778925128/Juan_Carlos_-_The_latin_Action_Salsa_y_Bachata_Company_umvorm.jpg"
      xlImage="https://res.cloudinary.com/dgvvnopu7/image/upload/v1778925128/Juan_Carlos_-_The_latin_Action_Salsa_y_Bachata_Company_umvorm.jpg"
      heroTitle="The Latin Action"
      heroSpan="Juan Carlos"
      heroSubtitle="🥇 Academia de Salsa y Bachata #1 en Elche"
    />

    <Logros />

    <section id="contenido" class="py-20 px-6 max-w-5xl mx-auto">
      <header>
        <h1
          class="text-4xl lg:text-6xl font-bebas tracking-bebas uppercase mb-12 text-center main-gradient-text drop-shadow-sm"
        >
          Clases de Salsa y Bachata en Elche
        </h1>
      </header>

      <div
        class="space-y-8 animate-fade-in backdrop-blur-sm bg-black/10 p-8 rounded-3xl border border-white/5"
        style="--animation-delay: 0.3s;"
      >
        <!-- SEO-optimized content with local keywords -->
        <div
          class="text-xl lg:text-2xl font-normal leading-relaxed text-gray-100 space-y-6"
        >
          <p>
            <strong class="text-main-gradient-from">The Latin Action</strong> es una
            compañía de baile latino que da clases de Salsa y Bachata en Elche, Novelda
            y Elda. Con más de 20 años de experiencia, nuestras clases te demostrarán
            que puedes aprender a bailar a tu ritmo, sin prisas.
          </p>

          <p>
            Entendemos que cada persona es diferente, y que el baile más que una
            forma de vida, es para disfrutar.
          </p>

          <p>
            También realizamos talleres, clases privadas y algún que otro evento
            para que puedas bailar fuera de clase. Porque lo importante es
            disfrutar del baile, y no solo aprenderlo.
          </p>
        </div>

        <!-- Local SEO callout box -->
        <div
          class="bg-main-gradient-from/10 rounded-2xl p-6 border border-main-gradient-from/20 mt-8"
        >
          <h2
            class="text-2xl font-bebas tracking-bebas text-main-gradient-from mb-4"
          >
            🗺️ Nuestras Ubicaciones en Alicante
          </h2>
          <div class="grid md:grid-cols-3 gap-4 text-sm">
            <a
              href="/clases-de-baile-elche/"
              class="flex items-center gap-2 p-3 rounded-lg hover:bg-white/10 transition-colors group"
            >
              <span class="text-main-gradient-from">📍</span>
              <span
                ><strong
                  class="group-hover:text-main-gradient-from transition-colors"
                  >Elche:</strong
                > Academia Dairen & Bubaloo</span
              >
            </a>
            <a
              href="/clases-de-baile-novelda/"
              class="flex items-center gap-2 p-3 rounded-lg hover:bg-white/10 transition-colors group"
            >
              <span class="text-main-gradient-from">📍</span>
              <span
                ><strong
                  class="group-hover:text-main-gradient-from transition-colors"
                  >Novelda:</strong
                > NVFit Gym</span
              >
            </a>
            <a
              href="/clases-de-baile-elda/"
              class="flex items-center gap-2 p-3 rounded-lg hover:bg-white/10 transition-colors group"
            >
              <span class="text-main-gradient-from">📍</span>
              <span
                ><strong
                  class="group-hover:text-main-gradient-from transition-colors"
                  >Elda:</strong
                > Estudio42</span
              >
            </a>
          </div>
        </div>

        <div class="flex justify-center mt-10">
          <a
            href="#modalidades"
            class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-main-gradient-from to-main-gradient-to text-white text-lg font-medium py-4 px-10 rounded-full shadow-xl hover:shadow-main-gradient-from/40 hover:scale-105 transition-all duration-300 overflow-hidden"
            aria-label="Ver todas nuestras modalidades de baile"
          >
            <span class="relative z-10"
              >🕺 Descubre nuestras modalidades 💃</span
            >
            <svg
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              class="relative z-10 transition-transform group-hover:translate-y-1"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
            <span
              class="absolute inset-0 bg-white/20 transform scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"
            ></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- <Knowledge KnowledgeData={KnowledgeData} />-->

  <ImageMasonry images={galleryImages} />
  <div class="flex justify-center my-12">
    <a
      href="/galeria/"
      class="flex items-center justify-center gap-2 bg-gradient-to-r from-main-gradient-from to-main-gradient-to text-white text-base font-medium py-3 px-8 rounded-full shadow-lg hover:shadow-main-gradient-from/30 hover:scale-105 transition-all duration-300"
    >
      Ver galería completa
      <svg
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        class="transition-transform group-hover:translate-x-1"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
  <Benefits />

  <!-- <Schedule /> -->

  <Partners />
  <HistoryLocation />
</Layout>
